# API Workbench Backend Configuration
PROJECT_NAME="API Workbench"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ENVIRONMENT="development"

# SQLite Database Configuration (default stored inside backend/database/api_workbench.db)
DATABASE_URL="sqlite:///./database/api_workbench.db"

# JWT Authentication Configuration
# Generate a secure 32+ character random key: openssl rand -hex 32 (or python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY="your_secure_random_jwt_secret_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email & SMTP Configuration for OTP Verification
# (Leave empty in local development to log OTP codes directly to server logs)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM=""
EMAIL_FROM_NAME="API Workbench"
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# OTP Policy Configuration
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5


